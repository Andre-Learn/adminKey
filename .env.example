# ───────── Frontend (PUBLIK, dibundel ke browser) ─────────
# Hanya URL dan anon key. JANGAN isi service role key di sini.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ───────── Server (RAHASIA, hanya untuk Vercel Functions) ─────────
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Pepper untuk HMAC-SHA256 license key & device id (min. 32 karakter).
# Generate: openssl rand -hex 32
# PERINGATAN: jika diganti, semua key lama tidak akan cocok lagi.
LICENSE_HASH_SECRET=

# Secret untuk menandatangani session token aktivasi (min. 32 karakter, beda dari di atas).
SESSION_SECRET=

# Opsional: origin yang boleh memanggil /api/license/* dari browser (pisahkan dengan koma).
# Kosongkan jika software Anda berupa aplikasi desktop/mobile/server (tidak butuh CORS).
ALLOWED_ORIGINS=
